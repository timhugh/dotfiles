#!/usr/bin/env bash

test_cmd="$1"
if [[ -z "$test_cmd" ]]; then
  echo "Usage: $0 <test-command>" >&2
  exit 1
fi

cleanup() {
    if [[ -n "$wpid" ]]; then
        kill "$wpid" 2>/dev/null
    fi
    exit
}
trap cleanup EXIT HUP INT TERM

watchexec --clear clear --restart --debounce 1s "notify \"$test_cmd\"" &
wpid=$!
wait "$wpid"
