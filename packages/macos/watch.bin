#!/usr/bin/env bash

cmd="$1"
if [[ -z "$cmd" ]]; then
  echo "Usage: $0 <cmd>" >&2
  exit 1
fi

cleanup() {
    if [[ -n "$wpid" ]]; then
        kill "$wpid" 2>/dev/null
    fi
    exit
}
trap cleanup EXIT HUP INT TERM

watchexec --clear clear --restart --debounce 1s "$cmd" &
wpid=$!
wait "$wpid"
