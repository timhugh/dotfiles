# remap prefix
unbind C-b
set-option -g prefix C-a
bind-key C-a send-prefix

# reload config file
bind ! source-file ~/.tmux.conf \; display "Reloaded config"

# remove delay for escape key
set -s escape-time 0

# open new windows in the same path
bind c new-window -c "#{pane_current_path}"

# split pane binds
unbind %
bind-key -n C-M-\\ split-window -h -c "#{pane_current_path}"
bind \\ split-window -h -c "#{pane_current_path}"
unbind '"'
bind-key -n C-M-- split-window -v -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"

# hide and show panes
bind-key j command-prompt -p "join pane from:"  "join-pane -s '%%'"
bind-key s command-prompt -p "send pane to:"  "join-pane -t '%%'"

is_vim="ps -o state= -o comm= -t '#{pane_tty}' \
  | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?g?(view|n?vim?x?)(diff)?$'"

bind-key -n M-h      if-shell   "$is_vim"   "send-keys M-h"     "select-pane -L"
bind-key -n M-j      if-shell   "$is_vim"   "send-keys M-j"     "select-pane -D"
bind-key -n M-k      if-shell   "$is_vim"   "send-keys M-k"     "select-pane -U"
bind-key -n M-l      if-shell   "$is_vim"   "send-keys M-l"     "select-pane -R"
bind-key -n C-M-h    if-shell   "$is_vim"   "send-keys C-M-h"   "select-pane -m; select-pane -L; swap-pane; select-pane -R; select-pane -M"
bind-key -n C-M-j    if-shell   "$is_vim"   "send-keys C-M-j"   "select-pane -m; select-pane -D; swap-pane; select-pane -U; select-pane -M"
bind-key -n C-M-k    if-shell   "$is_vim"   "send-keys C-M-k"   "select-pane -m; select-pane -U; swap-pane; select-pane -D; select-pane -M"
bind-key -n C-M-l    if-shell   "$is_vim"   "send-keys C-M-l"   "select-pane -m; select-pane -R; swap-pane; select-pane -L; select-pane -M"

# enable mouse
set -g mouse on

# disable auto-renaming windows
set-option -g allow-rename off
# remap rename key to r
unbind ,
bind r command-prompt -p "(rename-window)" "rename-window '%%'"
