{
	"diff_view_style": "unified",
	"cli_default_open_behavior": "existing_window",
	"agent_servers": {
		"pi-acp": {
			"default_config_options": {
				"thought_level": "medium",
			},
			"type": "registry",
		},
		"opencode": {
			"type": "registry",
		},
		"codex-acp": {
			"type": "registry",
		},
		"claude-acp": {
			"type": "registry",
		},
	},
	"project_panel": {
		"hide_hidden": false,
		"hide_root": false,
		"starts_open": false,
		"hide_gitignore": false,
		"default_width": 240.0,
		"auto_fold_dirs": true,
		"indent_size": 10,
	},
	"git": {
		"worktree_directory": ".git/zed/worktrees",
	},
	"edit_predictions": {
		"provider": "copilot",
		"mode": "subtle",
	},
	"sticky_scroll": {
		"enabled": true,
	},
	"hover_popover_enabled": true,
	"double_click_in_multibuffer": "open",
	"drop_target_size": 0.2,
	"colorize_brackets": false,
	"lsp_document_colors": "inlay",
	"inlay_hints": {
		"show_background": false,
		"toggle_on_modifiers_press": {
			"platform": true,
		},
		"enabled": false,
	},
	"show_whitespaces": "all",
	"indent_guides": {
		"background_coloring": "disabled",
		"coloring": "indent_aware",
	},
	"toolbar": {
		"quick_actions": false,
	},
	"auto_signature_help": false,
	"show_signature_help_after_edits": true,
	"which_key": {
		"enabled": true,
	},
	"current_line_highlight": "all",
	"icon_theme": "Zed (Default)",
	"ui_font_family": "Lilex",
	"ui_font_size": 14.0,
	"buffer_font_family": "Lilex",
	"buffer_font_size": 14.0,
	"theme": "Monokai Charcoal",
	// "theme": {
	// 	"mode": "system",
	// 	"light": "Dawnfox - opaque",
	// 	"dark": "1984 Cyberpunk"
	// },
	"buffer_line_height": "comfortable",
	"buffer_font_weight": 400.0,
	"agent": {
		"use_modifier_to_send": true,
		"play_sound_when_agent_done": "when_hidden",
		"default_profile": "ask",
		"default_model": {
			"provider": "copilot_chat",
			"model": "gpt-5.2",
		},
		"favorite_models": [],
		"model_parameters": [],
	},
	"autosave": "off",
	"format_on_save": "on",
	"vim_mode": true,
	"wrap_guides": [
		80,
		120
	],
	"hard_tabs": true,
	"tab_size": 4,
	"relative_line_numbers": "enabled",
	"lsp": {
		"ruby-lsp": {
			"initialization_options": {
				"enabledFeatures": {
					"diagnostics": false,
					"formatting": true,
				},
				"formatter": "standard",
			},
		},
		"zls": {
			"initialization_options": {
				"enable_autofix": true,
				"enable_build_on_save": true,
			},
		},
		"kotlin-lsp": {
			"binary": {
				"path": "kotlin-lsp",
				"arguments": [
					"--stdio"
				],
			},
		},
	},
	"languages": {
		"JSON": {
			"tab_size": 2,
			"hard_tabs": true,
		},
		"JSONC": {
			"tab_size": 2,
			"hard_tabs": true,
		},
		"Zig": {
			"format_on_save": "on",
			"formatter": "language_server",
			"language_servers": [
				"zls"
			],
		},
		"GLSL": {},
		"Markdown": {
			"soft_wrap": "editor_width",
		},
		"Ruby": {
			"tab_size": 2,
			"language_servers": [
				"ruby-lsp",
				"!standard",
				"!sorbet",
				"!solargraph",
				"!rubocop",
			],
			"formatter": "language_server",
			"enable_language_server": true,
		},
		"Make": {
			"hard_tabs": true,
		},
		"Kotlin": {
			"enable_language_server": true,
			"format_on_save": "off",
		},
	},
}
