[
	{
		"label": "Bujo search",
		"command": "zed $(bujo search)",
		"use_new_terminal": true,
		"reveal_target": "center",
		"hide": "on_success"
	},
	{
		"label": "Bujo current",
		"command": "zed $(bujo spread current)",
		"use_new_terminal": true,
		"reveal": "never",
		"hide": "on_success"
	},
	{
		"label": "Bujo next",
		"command": "zed $(bujo spread next)",
		"use_new_terminal": true,
		"reveal": "never",
		"hide": "on_success"
	},
	{
		"label": "Bujo forward",
		"command": "zed $(bujo spread next $ZED_FILE)",
		"use_new_terminal": true,
		"reveal": "never",
		"hide": "on_success"
	},
	{
		"label": "Bujo previous",
		"command": "zed $(bujo spread previous)",
		"use_new_terminal": true,
		"reveal": "never",
		"hide": "on_success"
	},
	{
		"label": "Bujo backward",
		"command": "zed $(bujo spread previous $ZED_FILE)",
		"use_new_terminal": true,
		"reveal": "never",
		"hide": "on_success"
	},
	{
		"label": "Bujo sync",
